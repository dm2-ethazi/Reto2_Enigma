<?xml version="1.0" encoding="utf-8"?>
<!-- Botón redondo de ayuda: mismo pergamino con volumen y aplastado al pulsar que el resto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E9D2A8"
                android:endColor="#DCC08E" />
            <stroke
                android:width="2dp"
                android:color="#8A5F28" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#2E000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#FDF5E2"
                        android:endColor="#EED8AA" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#A87A3E" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
