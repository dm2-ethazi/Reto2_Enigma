<?xml version="1.0" encoding="utf-8"?>
<!-- Etiqueta de pergamino: papel con volumen que se aplasta al pulsarla. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1AEBD8B2" />
            <stroke android:width="1.5dp" android:color="#667A5A2E" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#E9D2A8"
                        android:endColor="#DCC08E" />
                    <stroke android:width="2dp" android:color="#8A5F28" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="12dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#4D000000"
                        android:endColor="#00000000" />
                    <corners
                        android:topLeftRadius="6dp"
                        android:topRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2E000000" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#FDF5E2"
                        android:endColor="#EED8AA" />
                    <stroke android:width="1.5dp" android:color="#A87A3E" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item
                android:gravity="top"
                android:bottom="6dp"
                android:height="9dp"
                android:left="8dp"
                android:right="8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#4DFFFCF0"
                        android:endColor="#00FFFFFF" />
                    <corners
                        android:topLeftRadius="5dp"
                        android:topRightRadius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
