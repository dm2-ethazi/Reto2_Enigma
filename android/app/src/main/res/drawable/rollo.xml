<?xml version="1.0" encoding="utf-8"?>
<!-- Rollo de pergamino: cilindro con sombra suave en los extremos, sin dibujos. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="23dp"
    android:viewportWidth="400"
    android:viewportHeight="46">

    <path
        android:pathData="M22,2 H378 A20,20 0 0 1 378,42 H22 A20,20 0 0 1 22,2 Z"
        android:strokeWidth="1"
        android:strokeColor="#8A6023"
        android:strokeAlpha="0.3">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="2"
                android:endX="0" android:endY="42">
                <item android:offset="0" android:color="#B0874E" />
                <item android:offset="0.09" android:color="#E9D0A4" />
                <item android:offset="0.24" android:color="#FFF7E2" />
                <item android:offset="0.48" android:color="#F3DFBA" />
                <item android:offset="0.74" android:color="#D6AF76" />
                <item android:offset="0.92" android:color="#A87A44" />
                <item android:offset="1" android:color="#8A6030" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brillo longitudinal -->
    <path android:pathData="M50,10 H350 A3,3 0 0 1 350,15.5 H50 A3,3 0 0 1 50,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="26" android:startY="0"
                android:endX="374" android:endY="0">
                <item android:offset="0" android:color="#00FFF8E8" />
                <item android:offset="0.32" android:color="#4DFFF8E8" />
                <item android:offset="0.68" android:color="#38FFF8E8" />
                <item android:offset="1" android:color="#00FFF8E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sombra del canto inferior -->
    <path android:pathData="M40,32 H360 A4,4 0 0 1 360,40 H40 A4,4 0 0 1 40,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="26" android:startY="0"
                android:endX="374" android:endY="0">
                <item android:offset="0" android:color="#00000000" />
                <item android:offset="0.45" android:color="#2B000000" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Los extremos se curvan hacia dentro: sombra en degradado, sin líneas -->
    <path android:pathData="M22,2 H378 A20,20 0 0 1 378,42 H22 A20,20 0 0 1 22,2 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0"
                android:endX="400" android:endY="0">
                <item android:offset="0" android:color="#668A6020" />
                <item android:offset="0.055" android:color="#268A6020" />
                <item android:offset="0.13" android:color="#008A6020" />
                <item android:offset="0.87" android:color="#008A6020" />
                <item android:offset="0.945" android:color="#268A6020" />
                <item android:offset="1" android:color="#668A6020" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
