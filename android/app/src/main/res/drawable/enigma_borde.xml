<?xml version="1.0" encoding="utf-8"?>
<!-- Hueco sobre el pergamino: campo de texto e imagen, foco en ocre. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pergamino_campo" />
            <stroke android:width="2dp" android:color="@color/tinta_ocre" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pergamino_campo" />
            <stroke android:width="1.5dp" android:color="@color/pergamino_borde" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
