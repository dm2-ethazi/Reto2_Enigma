<?xml version="1.0" encoding="utf-8"?>
<!-- Pergamino: hoja de papel entre dos rollos que sobresalen a los lados. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="6dp"
        android:right="6dp"
        android:top="26dp"
        android:bottom="26dp"
        android:drawable="@drawable/papel" />

    <!-- Sombra del rollo superior sobre la hoja -->
    <item android:top="44dp" android:height="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33000000"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Sombra del rollo inferior sobre la hoja -->
    <item
        android:gravity="bottom"
        android:bottom="44dp"
        android:height="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#33000000"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="46dp"
        android:drawable="@drawable/rollo" />

    <item
        android:gravity="bottom"
        android:height="46dp"
        android:drawable="@drawable/rollo" />
</layer-list>
