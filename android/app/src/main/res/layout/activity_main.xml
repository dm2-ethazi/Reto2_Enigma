<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:text="CriptoApp"
            android:textSize="36sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"
            android:text="Herramientas de descifrado"
            android:textSize="17sp"
            android:textColor="@color/azul_texto"
            android:gravity="center" />

        <Button
            android:id="@+id/btnAesImagenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="▧   AES Imágenes   ›"
            android:textAllCaps="false"
            android:textColor="@color/magenta_texto"
            android:textSize="18sp"
            app:backgroundTint="@null"
            android:onClick="pantalla_aes"/>

        <Button
            android:id="@+id/btnCesarTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="▤   César Texto   ›"
            android:textAllCaps="false"
            android:textColor="@color/magenta_texto"
            android:textSize="18sp"
            app:backgroundTint="@null"
            android:onClick="pantalla_cesar"/>
    </LinearLayout>
</ScrollView>