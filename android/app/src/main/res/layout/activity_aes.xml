<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Volver"
                android:text="←"
                android:textColor="#222222"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descifrado AES"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportarEnc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:text="Importar archivo .enc"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etContrasena"
            android:text="Contraseña"
            android:textColor="#222222"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:gravity="center_vertical"
            android:padding="4dp">

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="password"
                android:background="@null"
                android:hint="Introduce la contraseña"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#222222"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnMostrarContrasena"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Mostrar contraseña"
                android:src="@android:drawable/ic_menu_view" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDescifrarAes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:text="Descifrar"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PNG recuperado"
            android:textColor="#222222"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/ivImagenRecuperada"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:contentDescription="Vista previa del PNG recuperado"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_gallery" />
    </LinearLayout>
</ScrollView>