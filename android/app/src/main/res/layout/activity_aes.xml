<?xml version="1.0" encoding="UTF-8"?>
<!-- AES: pergamino con el archivo, la contraseña y la imagen recuperada. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_mesa"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pergamino"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="60dp"
            android:paddingEnd="22dp"
            android:paddingBottom="60dp">

            <!-- Cabecera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVolver"
                    android:layout_width="54dp"
                    android:layout_height="46dp"
                    android:background="@drawable/boton_pergamino"
                    android:backgroundTint="@null"
                    android:contentDescription="Volver"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="3dp"
                    android:stateListAnimator="@null"
                    android:text="‹"
                    android:textAllCaps="false"
                    android:textColor="@color/tinta_magenta"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:letterSpacing="0.02"
                    android:text="Descifrado AES"
                    android:textColor="@color/pergamino_tinta"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/linea_pergamino" />

            <!-- Archivo cifrado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.14"
                android:text="ARCHIVO CIFRADO"
                android:textColor="@color/tinta_ocre"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnImportarEnc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:minHeight="60dp"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp"
                android:stateListAnimator="@null"
                android:text="Importar archivo .png.enc"
                android:textAllCaps="false"
                android:textColor="@color/tinta_azul"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/linea_pergamino" />

            <!-- Contraseña -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:labelFor="@id/etContrasena"
                android:letterSpacing="0.14"
                android:text="CONTRASEÑA"
                android:textColor="@color/tinta_ocre"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/enigma_borde"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:padding="4dp">

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:fontFamily="serif"
                    android:hint="Introduce la contraseña"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:maxLength="16"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/pergamino_tinta"
                    android:textColorHint="@color/pergamino_tinta_suave"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnMostrarContrasena"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Mostrar contraseña"
                    android:src="@drawable/ic_ojo_abierto"
                    app:tint="@color/tinta_magenta" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDescifrarAes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:letterSpacing="0.03"
                android:minHeight="66dp"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="17dp"
                android:stateListAnimator="@null"
                android:text="Descifrar"
                android:textAllCaps="false"
                android:textColor="@color/tinta_verde"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbProgresoAes"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#33A87A3E"
                android:progressTint="@color/tinta_verde"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEstadoAes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:textColor="@color/pergamino_tinta_suave"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/linea_pergamino" />

            <!-- Imagen recuperada -->
            <TextView
                android:id="@+id/tvTituloImagen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.14"
                android:text="IMAGEN RECUPERADA"
                android:textColor="@color/tinta_magenta"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivImagenRecuperada"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/enigma_borde"
                android:contentDescription="Vista previa del PNG recuperado"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_gallery" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
