<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@color/bg_header"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:drawable/ic_menu_revert"
                android:backgroundTint="@null"
                android:contentDescription="Volver"
                android:textColor="@color/azul_texto"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="12dp"
                android:text="Descifrado AES"
                android:textColor="@color/magenta_texto"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportarEnc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="Importar archivo .enc"
            android:textAllCaps="false"
            android:textColor="@color/magenta_texto"
            android:textSize="17sp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etContrasena"
            android:text="Contraseña"
            android:textColor="@color/amarillo_texto"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:gravity="center_vertical"
            android:padding="4dp">

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:autofillHints="password"
                android:background="@drawable/enigma_borde"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:hint="Introduce la contraseña"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnMostrarContrasena"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Mostrar contraseña"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/magenta_hover" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDescifrarAes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="Descifrar"
            android:textAllCaps="false"
            android:textColor="@color/magenta_texto"
            android:textSize="18sp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PNG recuperado"
            android:textColor="@color/magenta_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivImagenRecuperada"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/enigma_borde"
            android:contentDescription="Vista previa del PNG recuperado"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_gallery" />
    </LinearLayout>
</ScrollView>