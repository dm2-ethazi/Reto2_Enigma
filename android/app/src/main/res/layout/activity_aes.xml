<?xml version="1.0" encoding="UTF-8"?>
<!-- AES: pergamino que ocupa la pantalla; la imagen se ajusta al alto restante. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_mesa"
    android:orientation="vertical"
    android:paddingStart="@dimen/mesa_margen_h"
    android:paddingTop="@dimen/mesa_margen_sup"
    android:paddingEnd="@dimen/mesa_margen_h"
    android:paddingBottom="@dimen/mesa_margen_inf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pergamino"
        android:orientation="vertical"
        android:paddingStart="@dimen/pergamino_padding_h"
        android:paddingTop="@dimen/pergamino_padding_v"
        android:paddingEnd="@dimen/pergamino_padding_h"
        android:paddingBottom="@dimen/pergamino_padding_v">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolver"
                android:layout_width="@dimen/ancho_boton_volver"
                android:layout_height="@dimen/alto_boton_volver"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:contentDescription="@string/volver"
                android:fontFamily="serif"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="3dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/tinta_magenta"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/titulo_aes"
                android:textColor="@color/pergamino_tinta"
                android:textSize="@dimen/texto_titulo_pantalla"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/texto_titulo_pantalla"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAyuda"
                android:layout_width="@dimen/alto_boton_volver"
                android:layout_height="@dimen/alto_boton_volver"
                android:layout_marginStart="8dp"
                android:background="@drawable/boton_ayuda"
                android:backgroundTint="@null"
                android:contentDescription="@string/ayuda"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="0dp"
                android:stateListAnimator="@null"
                android:text="@string/ayuda_simbolo"
                android:textColor="@color/tinta_azul"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/linea_pergamino" />

        <!-- Archivo cifrado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:text="@string/archivo_cifrado"
            android:textColor="@color/tinta_ocre"
            android:textSize="@dimen/texto_etiqueta"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnImportarEnc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/boton_pergamino"
            android:backgroundTint="@null"
            android:fontFamily="serif"
            android:minHeight="@dimen/alto_boton_secundario"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="13dp"
            android:stateListAnimator="@null"
            android:text="@string/importar_enc"
            android:textAllCaps="false"
            android:textColor="@color/tinta_azul"
            android:textSize="@dimen/texto_boton_secundario"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/espacio_linea"
            android:layout_marginBottom="@dimen/espacio_linea"
            android:background="@drawable/linea_pergamino" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:labelFor="@id/etContrasena"
            android:letterSpacing="0.14"
            android:text="@string/contrasena"
            android:textColor="@color/tinta_ocre"
            android:textSize="@dimen/texto_etiqueta"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:gravity="center_vertical"
            android:minHeight="@dimen/alto_campo"
            android:padding="4dp">

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:autofillHints="password"
                android:background="@null"
                android:fontFamily="serif"
                android:hint="@string/contrasena_hint"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:maxLength="16"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/pergamino_tinta"
                android:textColorHint="@color/pergamino_tinta_suave"
                android:textSize="@dimen/texto_campo" />

            <ImageButton
                android:id="@+id/btnMostrarContrasena"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/mostrar_contrasena"
                android:src="@drawable/ic_ojo_abierto"
                app:tint="@color/tinta_magenta" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDescifrarAes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_seccion"
            android:background="@drawable/boton_pergamino"
            android:backgroundTint="@null"
            android:fontFamily="serif"
            android:letterSpacing="0.03"
            android:minHeight="@dimen/alto_boton"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="15dp"
            android:stateListAnimator="@null"
            android:text="@string/descifrar"
            android:textAllCaps="false"
            android:textColor="@color/tinta_verde"
            android:textSize="@dimen/texto_boton"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbProgresoAes"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#33A87A3E"
            android:progressTint="@color/tinta_verde"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEstadoAes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:textColor="@color/pergamino_tinta_suave"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/espacio_linea"
            android:layout_marginBottom="12dp"
            android:background="@drawable/linea_pergamino" />

        <!-- Imagen recuperada: ocupa todo el alto que sobra -->
        <TextView
            android:id="@+id/tvTituloImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:text="@string/imagen_recuperada"
            android:textAllCaps="true"
            android:textColor="@color/tinta_magenta"
            android:textSize="@dimen/texto_etiqueta"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivImagenRecuperada"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/enigma_borde"
            android:contentDescription="@string/vista_previa_desc"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_gallery" />
    </LinearLayout>
</LinearLayout>
