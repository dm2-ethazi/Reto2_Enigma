<?xml version="1.0" encoding="UTF-8"?>
<!-- César: pergamino que ocupa la pantalla; el mensaje crece con el alto restante. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_mesa"
    android:orientation="vertical"
    android:paddingStart="@dimen/mesa_margen_h"
    android:paddingTop="@dimen/mesa_margen_sup"
    android:paddingEnd="@dimen/mesa_margen_h"
    android:paddingBottom="@dimen/mesa_margen_inf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pergamino"
        android:orientation="vertical"
        android:paddingStart="@dimen/pergamino_padding_h"
        android:paddingTop="@dimen/pergamino_padding_v"
        android:paddingEnd="@dimen/pergamino_padding_h"
        android:paddingBottom="@dimen/pergamino_padding_v">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolver"
                android:layout_width="@dimen/ancho_boton_volver"
                android:layout_height="@dimen/alto_boton_volver"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:contentDescription="Volver"
                android:fontFamily="serif"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="3dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/tinta_magenta"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:text="Descifrado César"
                android:textColor="@color/pergamino_tinta"
                android:textSize="@dimen/texto_titulo_pantalla"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/linea_pergamino" />

        <!-- Archivo de texto -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:text="ARCHIVO DE TEXTO"
            android:textColor="@color/tinta_ocre"
            android:textSize="@dimen/texto_etiqueta"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnImportarTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/boton_pergamino"
            android:backgroundTint="@null"
            android:fontFamily="serif"
            android:minHeight="@dimen/alto_boton_secundario"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="13dp"
            android:stateListAnimator="@null"
            android:text="Importar .txt"
            android:textAllCaps="false"
            android:textColor="@color/tinta_azul"
            android:textSize="@dimen/texto_boton_secundario"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/espacio_linea"
            android:layout_marginBottom="@dimen/espacio_linea"
            android:background="@drawable/linea_pergamino" />

        <!-- Desplazamiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:labelFor="@id/etDesplazamiento"
            android:letterSpacing="0.14"
            android:text="DESPLAZAMIENTO (1–25)"
            android:textColor="@color/tinta_ocre"
            android:textSize="@dimen/texto_etiqueta"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDesplazamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:backgroundTint="@null"
            android:fontFamily="serif"
            android:hint="1"
            android:importantForAutofill="no"
            android:maxLength="2"
            android:minHeight="@dimen/alto_campo"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pergamino_tinta"
            android:textColorHint="@color/pergamino_tinta_suave"
            android:textSize="@dimen/texto_mensaje" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDescifrarCesar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_seccion"
            android:background="@drawable/boton_pergamino"
            android:backgroundTint="@null"
            android:fontFamily="serif"
            android:letterSpacing="0.03"
            android:minHeight="@dimen/alto_boton"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="15dp"
            android:stateListAnimator="@null"
            android:text="Descifrar"
            android:textAllCaps="false"
            android:textColor="@color/tinta_verde"
            android:textSize="@dimen/texto_boton"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/espacio_linea"
            android:layout_marginBottom="12dp"
            android:background="@drawable/linea_pergamino" />

        <!-- Mensaje recuperado: ocupa todo el alto que sobra -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:text="MENSAJE RECUPERADO"
            android:textColor="@color/tinta_magenta"
            android:textSize="@dimen/texto_etiqueta"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/enigma_borde"
            android:fadeScrollbars="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbarSize="4dp"
            android:scrollbarStyle="insideOverlay"
            android:scrollbarThumbVertical="@color/pergamino_borde"
            android:scrollbarTrackVertical="@android:color/transparent"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvMensajeRecuperado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="top|start"
                android:hint="El mensaje descifrado aparecerá aquí"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/pergamino_tinta"
                android:textColorHint="@color/pergamino_tinta_suave"
                android:textIsSelectable="true"
                android:textSize="@dimen/texto_mensaje" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
