<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Volver"
                android:text="←"
                android:textColor="#222222"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descifrado César"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportarTxt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:text="Importar .txt"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etDesplazamiento"
            android:text="Desplazamiento (1–25)"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etDesplazamiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:text=""
            android:hint="3"
            android:textColor="#222222"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnDescifrarCesar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:text="Descifrar"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mensaje recuperado"
            android:textColor="#222222"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMensajeRecuperado"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/enigma_borde"
            android:gravity="top|start"
            android:hint="El mensaje descifrado aparecerá aquí"
            android:textColor="#222222"
            android:textColorHint="#666666"
            android:textIsSelectable="true"
            android:textSize="17sp"
            tools:text="" />
    </LinearLayout>
</ScrollView>