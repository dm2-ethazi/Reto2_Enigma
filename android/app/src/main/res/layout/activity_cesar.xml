<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@color/bg_header"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:drawable/ic_menu_revert"
                android:backgroundTint="@null"
                android:contentDescription="Volver"
                android:textColor="@color/azul_texto"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="12dp"
                android:text="Descifrado César"
                android:textColor="@color/magenta_texto"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportarTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="Importar .txt"
            android:textAllCaps="false"
            android:textColor="@color/magenta_texto"
            android:textSize="17sp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etDesplazamiento"
            android:text="Desplazamiento (1–25)"
            android:textColor="@color/amarillo_texto"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etDesplazamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:padding="16dp"
            android:background="@drawable/enigma_borde"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:hint="3"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnDescifrarCesar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/enigma_boton"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="Descifrar"
            android:textAllCaps="false"
            android:textColor="@color/magenta_texto"
            android:textSize="18sp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mensaje recuperado"
            android:textColor="@color/magenta_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMensajeRecuperado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:layout_marginTop="8dp"
            android:padding="16dp"
            android:background="@drawable/enigma_borde"
            android:gravity="top|start"
            android:hint="El mensaje descifrado aparecerá aquí"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>