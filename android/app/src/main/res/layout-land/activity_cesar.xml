<?xml version="1.0" encoding="UTF-8"?>
<!-- César en horizontal: formulario compacto a la izquierda, mensaje a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_mesa"
    android:orientation="vertical"
    android:paddingStart="@dimen/mesa_margen_h"
    android:paddingTop="@dimen/mesa_margen_sup"
    android:paddingEnd="@dimen/mesa_margen_h"
    android:paddingBottom="@dimen/mesa_margen_inf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pergamino"
        android:orientation="vertical"
        android:paddingStart="@dimen/pergamino_padding_h"
        android:paddingTop="@dimen/pergamino_padding_v"
        android:paddingEnd="@dimen/pergamino_padding_h"
        android:paddingBottom="@dimen/pergamino_padding_v">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolver"
                android:layout_width="@dimen/ancho_boton_volver"
                android:layout_height="@dimen/alto_boton_volver"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:contentDescription="@string/volver"
                android:fontFamily="serif"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="3dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/tinta_magenta"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/titulo_cesar"
                android:textColor="@color/pergamino_tinta"
                android:textSize="@dimen/texto_titulo_pantalla"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/texto_titulo_pantalla"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAyuda"
                android:layout_width="@dimen/alto_boton_volver"
                android:layout_height="@dimen/alto_boton_volver"
                android:layout_marginStart="8dp"
                android:background="@drawable/boton_ayuda"
                android:backgroundTint="@null"
                android:contentDescription="@string/ayuda"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="0dp"
                android:stateListAnimator="@null"
                android:text="@string/ayuda_simbolo"
                android:textColor="@color/tinta_azul"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/linea_pergamino" />

        <!-- Dos columnas: formulario y mensaje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:letterSpacing="0.14"
                        android:text="@string/archivo_texto"
                        android:textColor="@color/tinta_ocre"
                        android:textSize="@dimen/texto_etiqueta"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnImportarTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/boton_pergamino"
                        android:backgroundTint="@null"
                        android:fontFamily="serif"
                        android:minHeight="@dimen/alto_boton_secundario"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="11dp"
                        android:stateListAnimator="@null"
                        android:text="@string/importar_txt"
                        android:textAllCaps="false"
                        android:textColor="@color/tinta_azul"
                        android:textSize="@dimen/texto_boton_secundario"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/linea_pergamino" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:labelFor="@id/etDesplazamiento"
                        android:letterSpacing="0.14"
                        android:text="@string/desplazamiento"
                        android:textColor="@color/tinta_ocre"
                        android:textSize="@dimen/texto_etiqueta"
                        android:textStyle="bold" />

                    <!-- Desplazamiento y botón en la misma fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etDesplazamiento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/enigma_borde"
                            android:backgroundTint="@null"
                            android:fontFamily="serif"
                            android:hint="@string/desplazamiento_hint"
                            android:importantForAutofill="no"
                            android:maxLength="2"
                            android:minHeight="@dimen/alto_campo"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/pergamino_tinta"
                            android:textColorHint="@color/pergamino_tinta_suave"
                            android:textSize="@dimen/texto_mensaje" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnDescifrarCesar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/boton_pergamino"
                            android:backgroundTint="@null"
                            android:fontFamily="serif"
                            android:letterSpacing="0.03"
                            android:minHeight="@dimen/alto_campo"
                            android:minWidth="140dp"
                            android:paddingStart="16dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="11dp"
                            android:stateListAnimator="@null"
                            android:text="@string/descifrar"
                            android:textAllCaps="false"
                            android:textColor="@color/tinta_verde"
                            android:textSize="@dimen/texto_boton"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <!-- Mensaje recuperado -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.14"
                    android:text="@string/mensaje_recuperado"
                    android:textColor="@color/tinta_magenta"
                    android:textSize="@dimen/texto_etiqueta"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/enigma_borde"
                    android:fadeScrollbars="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:scrollbarSize="4dp"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbarThumbVertical="@color/pergamino_borde"
                    android:scrollbarTrackVertical="@android:color/transparent"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/tvMensajeRecuperado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="top|start"
                        android:hint="@string/mensaje_hint"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/pergamino_tinta"
                        android:textColorHint="@color/pergamino_tinta_suave"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/texto_mensaje" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
