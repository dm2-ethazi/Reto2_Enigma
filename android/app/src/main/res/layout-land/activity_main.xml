<?xml version="1.0" encoding="UTF-8"?>
<!-- Inicio en horizontal: título centrado, los dos accesos en una fila y el idioma debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_mesa"
    android:orientation="vertical"
    android:paddingStart="@dimen/mesa_margen_h"
    android:paddingTop="@dimen/mesa_margen_sup"
    android:paddingEnd="@dimen/mesa_margen_h"
    android:paddingBottom="@dimen/mesa_margen_inf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pergamino"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/pergamino_padding_h"
        android:paddingTop="@dimen/pergamino_padding_v"
        android:paddingEnd="@dimen/pergamino_padding_h"
        android:paddingBottom="@dimen/pergamino_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/titulo_app"
            android:textColor="@color/pergamino_tinta"
            android:textSize="@dimen/texto_titulo_app"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/subtitulo_app"
            android:textColor="@color/pergamino_tinta_suave"
            android:textSize="@dimen/texto_subtitulo_app"
            android:textStyle="italic" />

        <View
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/linea_pergamino" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAesImagenes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:minHeight="@dimen/alto_boton"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp"
                android:stateListAnimator="@null"
                android:text="@string/accion_aes"
                android:textAllCaps="false"
                android:textColor="@color/tinta_azul"
                android:textSize="@dimen/texto_boton"
                android:textStyle="bold" />

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCesarTexto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:minHeight="@dimen/alto_boton"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp"
                android:stateListAnimator="@null"
                android:text="@string/accion_cesar"
                android:textAllCaps="false"
                android:textColor="@color/tinta_magenta"
                android:textSize="@dimen/texto_boton"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Idioma de la app -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.14"
                android:text="@string/idioma"
                android:textAllCaps="true"
                android:textColor="@color/tinta_ocre"
                android:textSize="@dimen/texto_etiqueta"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="168dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/enigma_borde"
                android:padding="2dp">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spIdioma"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="@string/idioma"
                    android:dropDownWidth="180dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="32dp"
                    android:popupBackground="@color/pergamino_alto"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:id="@+id/tvIdiomaFlecha"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="5dp"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_flecha_abajo" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAcercaDe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:minHeight="@dimen/alto_boton_secundario"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="11dp"
                android:stateListAnimator="@null"
                android:text="@string/acerca_de"
                android:textAllCaps="false"
                android:textColor="@color/tinta_azul"
                android:textSize="@dimen/texto_boton_secundario"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
