<?xml version="1.0" encoding="UTF-8"?>
<!-- Inicio en horizontal: título centrado y los dos accesos en una fila. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_mesa"
    android:orientation="vertical"
    android:paddingStart="@dimen/mesa_margen_h"
    android:paddingTop="@dimen/mesa_margen_sup"
    android:paddingEnd="@dimen/mesa_margen_h"
    android:paddingBottom="@dimen/mesa_margen_inf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pergamino"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/pergamino_padding_h"
        android:paddingTop="@dimen/pergamino_padding_v"
        android:paddingEnd="@dimen/pergamino_padding_h"
        android:paddingBottom="@dimen/pergamino_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="CriptoApp"
            android:textColor="@color/pergamino_tinta"
            android:textSize="@dimen/texto_titulo_app"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="Herramientas de descifrado"
            android:textColor="@color/pergamino_tinta_suave"
            android:textSize="@dimen/texto_subtitulo_app"
            android:textStyle="italic" />

        <View
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/linea_pergamino" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAesImagenes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:minHeight="@dimen/alto_boton"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp"
                android:stateListAnimator="@null"
                android:text="AES · Imágenes"
                android:textAllCaps="false"
                android:textColor="@color/tinta_azul"
                android:textSize="@dimen/texto_boton"
                android:textStyle="bold" />

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCesarTexto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/boton_pergamino"
                android:backgroundTint="@null"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:minHeight="@dimen/alto_boton"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp"
                android:stateListAnimator="@null"
                android:text="César · Texto"
                android:textAllCaps="false"
                android:textColor="@color/tinta_magenta"
                android:textSize="@dimen/texto_boton"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
