<?xml version="1.0" encoding="utf-8"?>
<!-- Pergamino en horizontal: rollos más finos para no comer altura de la pantalla. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="4dp"
        android:right="4dp"
        android:top="14dp"
        android:bottom="14dp"
        android:drawable="@drawable/papel" />

    <!-- Sombra del rollo superior sobre la hoja -->
    <item android:top="26dp" android:height="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33000000"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Sombra del rollo inferior sobre la hoja -->
    <item
        android:gravity="bottom"
        android:bottom="26dp"
        android:height="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#33000000"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="26dp"
        android:drawable="@drawable/rollo" />

    <item
        android:gravity="bottom"
        android:height="26dp"
        android:drawable="@drawable/rollo" />
</layer-list>
