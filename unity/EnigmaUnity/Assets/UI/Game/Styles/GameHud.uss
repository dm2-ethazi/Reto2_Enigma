.game-area {
    flex-grow: 1;
    min-width: 0;
    padding: 12px;
}

.game-area .scene-viewport {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
}

.game-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.game-stat {
    color: #eee7d6;
    font-size: 18px;
    -unity-font-style: bold;
}

.game-timer {
    min-width: 58px;
    margin-left: 4px;
    margin-right: 4px;
    color: #f5e4b8;
    -unity-text-align: middle-center;
}

.game-timer.timer-warning {
    color: #ff9b86;
}

.game-button {
    height: 44px;
    min-height: 44px;
    flex-shrink: 0;
    margin: 3px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #34474d;
    color: #f5e4b8;
    border-width: 1px;
    border-color: #637174;
    border-radius: 5px;
    font-size: 16px;
    -unity-font-style: bold;
}

.game-button:hover {
    background-color: #4b6064;
    border-color: #d3b77a;
}

.game-button:disabled {
    opacity: 0.5;
}

.answer-panel {
    flex-shrink: 0;
    padding-top: 8px;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: #344248;
}

.clue-note {
    font-size: 14px;
    color: #d3b77a;
    white-space: normal;
}

.cipher-message {
    font-size: 23px;
    -unity-font-style: bold;
    color: #f5e4b8;
    white-space: normal;
}

.answer-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.answer-input {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.answer-input .unity-base-text-field__input {
    height: 44px;
    min-height: 44px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #202e35;
    color: #ffffff;
    border-width: 1px;
    border-color: #637174;
    border-radius: 5px;
    font-size: 18px;
}

.game-feedback {
    min-height: 20px;
    font-size: 14px;
    color: #c4cdcf;
    white-space: normal;
}

.clue-hit-area {
    position: absolute;
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 24px;
}

.clue-hit-area:hover {
    background-color: rgba(211, 183, 122, 0.15);
}

.game-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 12, 16, 0.94);
}

.modal-card {
    width: 80%;
    max-width: 400px;
    padding: 16px;
    background-color: #202e35;
    border-width: 1px;
    border-color: #7c6b48;
    border-radius: 8px;
}

.modal-title {
    font-size: 28px;
    color: #f5e4b8;
    -unity-font-style: bold;
}

.modal-message {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 10px;
}

.hidden {
    display: none;
}

.compact .game-area {
    padding: 6px 8px;
}

.compact .game-header {
    margin-bottom: 2px;
}

.compact .game-stat {
    font-size: 14px;
}

.compact .cipher-message {
    font-size: 18px;
}

.compact .answer-panel {
    padding-top: 4px;
    margin-top: 3px;
}

.compact .clue-note {
    font-size: 12px;
}

.compact .game-feedback {
    font-size: 12px;
    min-height: 16px;
}
